# ====================================================================
# DAWIT TELECOM ENTERPRISE SUITE - CONFIGURATION TEMPLATE
# ====================================================================
# INSTRUCTIONS: Copy this file to '.env' and fill in your real values.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GIT CONTROL!
# ====================================================================

# --------------------------------------------------------------------
# 1. NETWORK TARGETS CONFIGURATION (Dynamic IPs)
# --------------------------------------------------------------------
# Add dynamic Target IPs separated by commas (No hardcoding in main.py)
TARGET_HOST=192.168.1.1,8.8.8.8,10.0.0.12,1.1.1.1

# --------------------------------------------------------------------
# 2. TELEGRAM INCIDENT BOT CREDENTIALS
# --------------------------------------------------------------------
# Obtain your token via Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Obtain your Chat ID via Telegram @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --------------------------------------------------------------------
# 3. TWILIO SMS GATEWAY (Optional Fallback Alerting)
# --------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+12345678900
ENGINEER_PHONE_NUMBER=+251911223344


# --------------------------------------------------------------------
# 4. REMOTE SSH SELF-HEALING CREDENTIALS (Paramiko Engine)
# --------------------------------------------------------------------
SSH_USERNAME=admin
SSH_PASSWORD=your_secure_ssh_password
SSH_PORT=22

# --------------------------------------------------------------------
# 5. MONITORING ENGINE TIMINGS & THRESHOLDS
# --------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=10
MAX_FAILURE_THRESHOLD=3
FLASK_PORT=5000
